# Supabase — Settings → API di dashboard project Anda.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # server-side only, JANGAN pernah dikirim ke browser

# Base URL aplikasi (dipakai untuk redirect email verifikasi & webhook/return iPaymu).
NEXT_PUBLIC_APP_URL=https://<domain-anda>/

# Opsional — hanya untuk supabase/seed.ts (buat akun DEVELOPER via --email).
DEVELOPER_PASSWORD=<password-kuat>

# Opsional — hanya bila mengaktifkan pembayaran otomatis iPaymu (V10 infak).
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_ENV=sandbox
